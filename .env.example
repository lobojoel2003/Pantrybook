# Copy to .env for local development (`npm run dev` reads it via Vite) or pass these
# to `node build` / Docker. All are optional.

# Where the SQLite database lives. Mount a persistent volume here in production.
PANTRYBOOK_DATA_DIR=./data

# Fill the database with fictional data and show demo sign-in hints.
PANTRYBOOK_DEMO=false
# Hours between demo resets (0 = only when the server starts).
PANTRYBOOK_DEMO_RESET_HOURS=24

# How long people stay signed in, in days.
PANTRYBOOK_SESSION_DAYS=30

# Days of visit history each device keeps for offline use (limits need up to a year).
PANTRYBOOK_OFFLINE_VISIT_DAYS=400

# Force the Secure flag on the session cookie (true/false). Detected automatically.
# PANTRYBOOK_SECURE_COOKIES=

# Web server (from @sveltejs/adapter-node)
PORT=3000
HOST=0.0.0.0
# Behind a reverse proxy that terminates HTTPS:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# Allow bigger spreadsheet imports
BODY_SIZE_LIMIT=10M
